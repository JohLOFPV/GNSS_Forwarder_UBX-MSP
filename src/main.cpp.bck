// Helper: Convert NMEA DDMM.MMMM to Decimal Degrees
float convertNmeaCoord(const char* nmeaCoord, const char* direction) {
  if (nmeaCoord[0] == '\0') return 0.0;
  float val = atof(nmeaCoord);
  int degrees = (int)(val / 100);
  float minutes = val - (degrees * 100);
  float decimal = degrees + (minutes / 60.0);
  if (direction[0] == 'S' || direction[0] == 'W') decimal *= -1;
  return decimal;
}

// Helper: Calculate NMEA Checksum (XOR between '$' and '*')
bool verifyNMEAChecksum(const char* sentence) {
  uint8_t checksum = 0;
  const char* p = sentence + 1; // Skip '$'
  while (*p && *p != '*') {
    checksum ^= *p;
    p++;
  }
  if (*p != '*') return false;
  
  // Parse the 2 hex chars after '*'
  uint8_t received = 0;
  p++; // Skip '*'
  for (int i = 0; i < 2; i++) {
    char c = p[i];
    received <<= 4;
    if (c >= '0' && c <= '9') received |= (c - '0');
    else if (c >= 'A' && c <= 'F') received |= (c - 'A' + 10);
    else if (c >= 'a' && c <= 'f') received |= (c - 'a' + 10);
    else return false;
  }
  return (checksum == received);
}

void processGps() {
  static char lineBuf[82]; // Max NMEA sentence length
  static uint8_t pos = 0;

  while (GPSSerial.available()) {
    uint8_t c = GPSSerial.read();

    // Reset if buffer full or newline detected
    if (c == '\n') {
      lineBuf[pos] = '\0';
      
      // Process only if starts with '$' and passes checksum
      if (pos > 6 && lineBuf[0] == '$' && verifyNMEAChecksum(lineBuf)) {
        
        // Check for GGA sentence (Global Positioning System Fix Data)
        if (strncmp(lineBuf, "$GPGGA", 6) == 0 || strncmp(lineBuf, "$GNGGA", 6) == 0) {
          char* token;
          char* rest = lineBuf;
          int field = 0;
          
          // Tokenize by comma
          while ((token = strtok_r(rest, ",", &rest)) != NULL) {
            switch (field) {
              case 1: // Time (skip)
                break;
              case 2: // Latitude
                gps.lat = convertNmeaCoord(token, strtok_r(NULL, ",", &rest)); // Next token is N/S
                field++; // Skip direction token manually since we consumed it
                break;
              case 4: // Longitude
                gps.lon = convertNmeaCoord(token, strtok_r(NULL, ",", &rest)); // Next token is E/W
                field++; 
                break;
              case 6: // Fix Quality (0=invalid, 1=GPS, 2=DGPS, 4=RTK)
                gps.fix = (atoi(token) >= 1);
                break;
              case 7: // Satellites
                gps.sats = atoi(token);
                break;
              case 9: // Altitude (meters)
                gps.alt = atof(token);
                break;
              // Speed/Course are NOT in GGA, use RMC sentence for those
            }
            field++;
          }
          navCount++;
          lastGpsPacket = millis();
        }
        
        // Optional: Parse RMC for Speed/Course if needed
        else if (strncmp(lineBuf, "$GPRMC", 6) == 0 || strncmp(lineBuf, "$GNRMC", 6) == 0) {
           // Similar tokenization logic for Speed (field 7) and Course (field 8)
           // Note: RMC field 2 is Status (A=Active/V=Void)
        }
      }
      pos = 0; // Reset buffer
    } 
    else if (c != '\r' && pos < sizeof(lineBuf) - 1) {
      lineBuf[pos++] = c;
    }
  }
}
void updateLed(){
      if (!lastGpsPacket || millis() - lastGpsPacket > 5000)
        digitalWrite(LED_PIN, (millis() / 250) & 1);
      else if (!gps.fix)
        digitalWrite(LED_PIN, (millis() / 1000) & 1);
      else
        digitalWrite(LED_PIN, LOW); }
void stats(){
      static uint32_t t = 0;
      if (millis() - t > 10000)
      {
        t = millis(); Serial.printf("NAV:%lu MSP:%lu ERR:%lu SAT:%u FIX:%u\n",navCount,mspCount,ckErr,gps.sats,gps.fix); }}


void setup(){

  pinMode(LED_PIN, OUTPUT);

  Serial.begin(115200);

  while (!Serial) {
    ;  // wait for serial port to connect. Needed for native USB port only
  }

  Serial.println("GPS->MSP Bridge Debug port");

  FCSerial.begin(9600);

  uint32_t baud;

  if (detectBaud(baud)) Serial.printf("[GPS] Detected %lu\n",baud); else Serial.println("[GPS] Not found"); }
void loop(){
              processGps();
              static uint32_t t = 0;
              if (millis() - t >= 200)
              {
                t = millis();
                sendMSP();
              }
              if (lastGpsPacket && millis() - lastGpsPacket > 5000)
                Serial.println("[GPS] Timeout, reconfigure/reconnect logic can be added here");
              updateLed();
              stats(); }
