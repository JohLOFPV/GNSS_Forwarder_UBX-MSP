#include <Arduino.h>
// GPS->MSP bridge example for STM32 Blackpill F411
// Features:
// - GPS baud autodetect
// - UBX MON-VER probe
// - UBX checksum verification
// - ACK/NAK handling
// - NAV-PVT parsing
// - MSP_SET_RAW_GPS output at 9600 baud
// - GPS timeout detection
// - USB debug output
// - LED status
HardwareSerial GPSSerial(USART1); // PA10(RX), PA9(TX) are default for USART1 on Blackpill
HardwareSerial FCSerial(USART2);  // PA3(RX), PA2(TX) are default for USART2, BUT you want PB7/PB6

#define LED_PIN PC13
#define MSP_SET_RAW_GPS 201
struct GPSData
{
  bool fix = false;
  uint8_t sats = 0;
  int32_t lat = 0, lon = 0;
  uint16_t alt = 0, speed = 0, course = 0;
} gps;
uint32_t lastGpsPacket = 0, navCount = 0, mspCount = 0, ckErr = 0;
const uint32_t bauds[] = {9600, 19200, 38400, 57600, 115200};
void ubxChecksum(const uint8_t *d, uint16_t l, uint8_t &a, uint8_t &b)
{
  a = b = 0;
  for (uint16_t i = 0; i < l; i++)
  {
    a += d[i];
    b += a;
  }
}
bool verifyUBX(uint8_t *buf)
{
  uint16_t len = buf[4] | (buf[5] << 8);
  uint8_t a, b;
  ubxChecksum(&buf[2], len + 4, a, b);
  return a == buf[len + 6] && b == buf[len + 7];
}

void sendMSP()
{
    // MSP2_SENSOR_GPS payload
    // Layout used by INAV:
    //
    // fixType      uint8_t
    // numSat       uint8_t
    // lat          int32_t
    // lon          int32_t
    // altCm        int32_t
    // groundSpeed  uint16_t (cm/s)
    // groundCourse uint16_t (deg * 10)
    // hdop         uint16_t
    //
    // Total: 20 bytes

    uint8_t payload[20];
    uint8_t idx = 0;

    payload[idx++] = gps.fix ? 3 : 0;  // 3D fix or no fix
    payload[idx++] = gps.sats;

    memcpy(&payload[idx], &gps.lat, 4);
    idx += 4;

    memcpy(&payload[idx], &gps.lon, 4);
    idx += 4;

    int32_t altCm = (int32_t)gps.alt * 100;
    memcpy(&payload[idx], &altCm, 4);
    idx += 4;

    memcpy(&payload[idx], &gps.speed, 2);
    idx += 2;

    memcpy(&payload[idx], &gps.course, 2);
    idx += 2;

    uint16_t hdop = 100;   // placeholder
    memcpy(&payload[idx], &hdop, 2);
    idx += 2;

    const uint16_t payloadSize = idx;

    //
    // MSPv2 header
    //
    FCSerial.write('$');
    FCSerial.write('X');
    FCSerial.write('<');

    uint8_t flags = 0;

    FCSerial.write(flags);

    FCSerial.write((uint8_t)(MSP2_SENSOR_GPS & 0xFF));
    FCSerial.write((uint8_t)(MSP2_SENSOR_GPS >> 8));

    FCSerial.write((uint8_t)(payloadSize & 0xFF));
    FCSerial.write((uint8_t)(payloadSize >> 8));

    //
    // MSPv2 CRC8 DVB-S2
    //
    uint8_t crc = 0;

    auto crc8_dvb_s2 = uint8_t crc, uint8_t a
    {
        crc ^= a;

        for (int i = 0; i < 8; i++)
        {
            if (crc & 0x80)
                crc = (crc << 1) ^ 0xD5;
            else
                crc <<= 1;
        }

        return crc;
    };

    crc = crc8_dvb_s2(crc, flags);
    crc = crc8_dvb_s2(crc, MSP2_SENSOR_GPS & 0xFF);
    crc = crc8_dvb_s2(crc, MSP2_SENSOR_GPS >> 8);
    crc = crc8_dvb_s2(crc, payloadSize & 0xFF);
    crc = crc8_dvb_s2(crc, payloadSize >> 8);

    for (uint16_t i = 0; i < payloadSize; i++)
    {
        FCSerial.write(payload[i]);
        crc = crc8_dvb_s2(crc, payload[i]);
    }

    FCSerial.write(crc);

    mspCount++;
}
