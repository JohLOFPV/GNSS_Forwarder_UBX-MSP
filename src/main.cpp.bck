bool pollMonVer()
{
  const uint8_t q[] = {0xB5, 0x62, 0x0A, 0x04, 0, 0, 0x0E, 0x34};

  while(GPSSerial.available()) GPSSerial.read();

  GPSSerial.write(q, sizeof(q));
  uint32_t t = millis() + 5000;
  while (millis() < t)
  {
    if (GPSSerial.available() > 4)
    {
      u_int8_t data[5];
      for(u_int8_t i = 0; i < 5; i++) data[i] = GPSSerial.read();
      if (data[0] == 0xB5 && data[1] == 0x62)
      {
        if (data[2] == 0x0A && data[3] == 0x04)
          return true;
      }
    }
  }
  return false;
}
bool detectBaud(uint32_t &b)
{
  for (int i = 0; i < 5; i++)
  {
    
    GPSSerial.begin(bauds[i]);
    delay(2000);
  
    while (GPSSerial.available() > 0)
    {
      GPSSerial.read(); 
      Serial.print("[GPS] Trying "); 
      Serial.println(bauds[i]);
      if(pollMonVer())
      {
        b=bauds[i]; 
        return true;
      }
    } 
    
  }
  return false;
}   



